XGBOOST_MODEL_PATH=./models/xgboost_forecast.json
SENTENCE_TRANSFORMER_MODEL=BAAI/bge-small-en-v1.5

# API Keys
OPENAI_API_KEY=
SERPER_API_KEY=
GITHUB_TOKEN=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
